# CLEANAIR AI Environment Configuration

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Cloud & Gemini Configuration
GCP_PROJECT_ID=cleanair-ai-prod
GCP_REGION=us-central1
GEMINI_API_KEY=mock-gemini-api-key-for-local-dev
GEMINI_MODEL=gemini-1.5-pro

# Provider Configuration
POLLUTION_PROVIDER=mock  # Options: mock, openaq, waqi, google_air_quality
WEATHER_PROVIDER=mock    # Options: mock, openweathermap

# Pub/Sub Topics
PUBSUB_TOPIC_UPDATES=pollution-updates
PUBSUB_TOPIC_ALERTS=pollution-alerts
PUBSUB_TOPIC_EVENTS=agent-events

# Vector Store / RAG
EMBEDDING_DIMENSION=384
RAG_TOP_K=5

# Security & CORS
ALLOWED_ORIGINS=*
SECRET_KEY=cleanair-ai-super-secret-key-change-in-production
